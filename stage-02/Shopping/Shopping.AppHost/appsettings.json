{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Warning",
      "Aspire.Hosting.Dcp": "Warning"
    }
  },
  "Aspire": {
    "MongoDB": {
      "Driver": {
        "ConnectionString": "mongodb://catalogDb"
      }
    },
    "Microsoft": {
      "EntityFrameworkCore": {
        "SqlServer": {
          "ConnectionString": "Data Source=cartdb;Initial Catalog=master",
          "DbContextPooling": true,
          "DisableHealthChecks": true,
          "DisableTracing": true,
          "DisableMetrics": false
        }
      }
    }
  },
  "Parameters": {
    "productDb-port": 7000,
    "cartDb-port": 7001
  },
  "DatabaseSettings": {
    "DatabaseName": "ProductDb",
    "CollectionName": "Products",
    "BrandsCollection": "Brands",
    "TypesCollection": "Types"
  }
}